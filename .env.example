# --- Kalshi ---
# "demo" -> https://demo-api.kalshi.co/trade-api/v2 (fake money; keys are created at demo.kalshi.co)
# "prod" -> https://api.elections.kalshi.com/trade-api/v2 (real money)
KALSHI_ENV=demo
KALSHI_API_KEY=your-key-id-uuid
# Full PEM. In Vercel paste it as-is, or as one line with literal \n escapes.
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Redis (Upstash, added via Vercel Marketplace; either name pair works) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Cron auth: Vercel sends "Authorization: Bearer $CRON_SECRET". Use 16+ random chars. ---
CRON_SECRET=

# --- Safety: orders are only sent when DRY_RUN is exactly "false" ---
DRY_RUN=true

# --- Risk / strategy (defaults shown) ---
MAX_RISK_PER_TRADE_USD=5
MAX_DAILY_LOSS_USD=15
MAX_CONTRACTS=20
MAX_ENTRY_PRICE_CENTS=70
SLIPPAGE_CENTS=2
MAX_MINUTES_LEFT=5
MIN_MINUTES_LEFT=0.75
MIN_EDGE=0.05
MIN_MOMENTUM_Z=0.5
